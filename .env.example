# Server-side (set in Netlify env vars or .env.local for `netlify dev`)
ANTHROPIC_API_KEY=your_api_key_here
FIREBASE_DB_URL=https://your-project.firebaseio.com

# Client-side observability (must be prefixed VITE_ to reach the browser bundle).
# Set these in BOTH Netlify and Vercel dashboards, scope = all environments.
# Without these, observability silently no-ops — the app still runs fine.
VITE_SENTRY_DSN=https://your-key@oXXXXX.ingest.sentry.io/XXXXX
VITE_POSTHOG_KEY=phc_your_project_api_key
VITE_POSTHOG_HOST=https://us.i.posthog.com
