{
  "rewrites": [
    { "source": "/api/register", "destination": "/api/auth?action=register" },
    { "source": "/api/refresh", "destination": "/api/auth?action=refresh" },
    { "source": "/api/revoke", "destination": "/api/auth?action=revoke" },
    { "source": "/api/push-config", "destination": "/api/push?action=config" },
    { "source": "/api/push-subscribe", "destination": "/api/push?action=subscribe" },
    { "source": "/api/cron-push", "destination": "/api/push?action=cron" },
    { "source": "/api/teacher-bio", "destination": "/api/teacher?action=bio" },
    { "source": "/api/teacher-search", "destination": "/api/teacher?action=search" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/learn/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800" }
      ]
    }
  ],
  "crons": [
    { "path": "/api/push?action=cron", "schedule": "0 9 * * *" }
  ]
}
